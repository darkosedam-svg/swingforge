# swingforge VPS environment file.
#
# deploy/install.sh copies this to /etc/swingforge.env, but only the first time (it never
# overwrites an existing /etc/swingforge.env, so edits made there survive an upgrade).
# Target mode/owner: 0640 root:swingforge -- readable by the swingforge group, writable
# only by root. Never commit a filled-in copy of this file.

# Where DuckDB files, backfilled bars and tournament reports live (default if unset: "data",
# which is wrong for a service -- the units below always set this explicitly).
SWINGFORGE_DATA_DIR=/var/lib/swingforge

# Bearer token required by `swingforge web --host 0.0.0.0 ...` (the CLI refuses to bind
# 0.0.0.0 without one). Generate with: openssl rand -hex 32
SWINGFORGE_TOKEN=

# OANDA v20 PRACTICE account credentials -- paper trading only, never a live account.
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Hyperliquid read-only wallet address. Not read by `swingforge paper` today; reserved for
# a future live-execution spec.
HL_ACCOUNT_ADDRESS=
